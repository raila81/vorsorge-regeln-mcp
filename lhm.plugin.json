    {
      "name": "notarkosten_berechnen",
      "title": "Notarkosten berechnen",
      "description": "Use when someone asks what a German notary charges for a will or a power of attorney: \"Was kostet ein Testament beim Notar\", \"Notarkosten Vorsorgevollmacht\", \"Berliner Testament Notar Kosten\", \"Erbvertrag Kosten\", \"Vollmacht beglaubigen lassen Kosten\". Computes the fee under the German court and notary fees act (GNotKG, Tabelle B, as amended 2025) from the document type and the assets in euros: business value (Geschäftswert), fee rate, minimum fees, postage flat rate (Nr. 32005 KV), 19 % VAT and the total. For wills it also compares notary, lawyer and handwritten will with court custody and register fees. Only the document type and an amount are needed; never ask for a name or other personal details.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dokument": {
            "type": "string",
            "enum": [
              "testament",
              "gemeinschaftliches_testament",
              "vorsorgevollmacht_beurkundet",
              "vorsorgevollmacht_beglaubigt"
            ],
            "description": "testament = Einzeltestament; gemeinschaftliches_testament = Berliner Testament oder Erbvertrag (2,0-Gebühr); vorsorgevollmacht_beurkundet = notarielle Beurkundung; vorsorgevollmacht_beglaubigt = nur Unterschriftsbeglaubigung unter einem fertigen Text."
          },
          "vermoegen": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000,
            "description": "Vermögen in Euro (Aktivvermögen, bei Ehepaaren gemeinsam). Eine Schätzung genügt."
          },
          "schulden": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000,
            "description": "Schulden in Euro, optional. Zählen nur beim Testament, höchstens bis zur Hälfte des Vermögens (§ 102 GNotKG)."
          }
        },
        "required": [
          "dokument",
          "vermoegen"
        ],
        "additionalProperties": false
      },
