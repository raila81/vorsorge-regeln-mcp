    {
      "name": "erbquoten_berechnen",
      "title": "Erbquoten und Pflichtteil berechnen",
      "description": "Use when someone asks who inherits without a will in Germany and how much: \"Wer erbt ohne Testament\", \"gesetzliche Erbfolge Ehefrau Kinder\", \"Erbquote Ehegatte\", \"Pflichtteil berechnen\", \"erben Geschwister\". Returns the statutory shares and compulsory portions (Pflichtteil) under §§ 1924 to 1926, 1931, 1371 and 2303 BGB for spouse, children, parents and siblings, as fractions and percentages with the paragraphs. Inputs are only marital status, matrimonial property regime and the number of living relatives; never ask for names. The calculator stops at the third order (grandparents and their descendants).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "verheiratet": {
            "type": "boolean",
            "description": "War die verstorbene Person verheiratet oder in eingetragener Lebenspartnerschaft?"
          },
          "gueterstand": {
            "type": "string",
            "enum": [
              "zugewinngemeinschaft",
              "guetertrennung",
              "guetergemeinschaft"
            ],
            "description": "Nur bei verheiratet. Ohne Ehevertrag gilt die Zugewinngemeinschaft (Standard)."
          },
          "kinder": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20,
            "description": "Zahl der lebenden Kinder."
          },
          "eltern": {
            "type": "string",
            "enum": [
              "beide",
              "einer",
              "keiner"
            ],
            "description": "Nur ohne Kinder: Leben die Eltern noch?"
          },
          "geschwister": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20,
            "description": "Nur ohne Kinder und wenn nicht beide Eltern leben: Zahl der Geschwister."
          },
          "grosseltern": {
            "type": "boolean",
            "description": "Nur verheiratet, ohne Kinder, Eltern und Geschwister: Lebt noch mindestens ein Großelternteil?"
          }
        },
        "required": [
          "verheiratet",
          "kinder"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "eingaben": {
            "type": "object"
          },
          "erben": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "wer": {
                  "type": "string"
                },
                "anzahl": {
                  "type": "integer"
                },
                "erbquote": {
                  "type": "string"
                },
                "erbquote_prozent": {
                  "type": "number"
                },
                "paragrafen": {
                  "type": "string"
                },
                "pflichtteil": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "pflichtteil_prozent": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "pflichtteil_paragrafen": {
                  "type": "string"
                }
              },
              "required": [
                "wer",
                "anzahl",
                "erbquote",
                "erbquote_prozent",
                "paragrafen",
                "pflichtteil"
              ]
            }
          },
          "hinweise": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rechner_endet": {
            "type": "boolean"
          },
